# ---------------------------------------------------------------------------
# SPARK environment variables — copy to .env.local and fill in.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.
# See ENVIRONMENT_VARIABLES.md for details.
# ---------------------------------------------------------------------------

# Supabase (public: safe to expose to the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
# New publishable key (sb_publishable_...) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...) or legacy service_role JWT. SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Private S3-compatible photo storage (Railway Storage Bucket). SERVER ONLY.
# Values come from the bucket's Credentials tab — see STORAGE_SETUP.md.
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# "true" only if the bucket's Credentials tab says to use path-style URLs
S3_FORCE_PATH_STYLE=false

# Public URL of this app (used for auth redirects), no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Photo moderation: "manual" (default — moderators approve photos) or "auto"
PHOTO_MODERATION_MODE=manual

# Random string sent as a Bearer token to /api/cron/cleanup by the cron job
CRON_SECRET=
