# ---------------------------------------------------------------------------
# SPARK environment variables — copy to .env.local and fill in.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.
# See ENVIRONMENT_VARIABLES.md for details.
# ---------------------------------------------------------------------------

# Supabase (public: safe to expose to the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
# Legacy anon JWT or new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role / secret key (sb_secret_...). SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (private bucket). SERVER ONLY.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Public URL of this app (used for auth redirects), no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Photo moderation: "manual" (default — moderators approve photos) or "auto"
PHOTO_MODERATION_MODE=manual

# Random string; Vercel Cron sends it as a Bearer token to /api/cron/cleanup
CRON_SECRET=
